{
  "model": {
    "d_model": 256,
    "num_experts": 7,
    "max_depth": 7,
    "num_blocks": 2,
    "dropout": 0.1
  },
  "training": {
    "lr": 0.003,
    "weight_decay": 0.0001,
    "batch_size": 128,
    "seq_len": 64,
    "epochs": 5,
    "val_split": 0.1,
    "grad_clip": 1.0,
    "subset_fraction": 0.10,
    "subset_seed": 42
  },
  "loss_weights": {
    "task": 1.0,
    "routing_balance": 0.01,
    "halting": 0.001
  },
  "data": {
    "train_path": "../data/train.jsonl",
    "val_path": "../data/val.jsonl",
    "test_path": "../data/test.jsonl",
    "max_val": 1000000,
    "pad_value": 0.0
  },
  "logging": {
    "wandb_project": "micro-MoRE-fastsearch",
    "log_interval": 1
  }
}