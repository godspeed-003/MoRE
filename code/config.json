{
  "model": {
    "d_model": 256,
    "num_experts": 7,
    "max_depth": 7,
    "num_blocks": 2,
    "dropout": 0.1
  },
  "training": {
    "lr": 1e-3,
    "weight_decay": 1e-4,
    "batch_size": 128,
    "seq_len": 64,
    "epochs": 50,
    "val_split": 0.1,
    "grad_clip": 1.0
  },
  "loss_weights": {
    "task": 1.0,
    "routing_balance": 0.01,
    "halting": 0.001
  },
  "data": {
    "jsonl_path": "dummy.jsonl",
    "max_val": 1e6,
    "pad_value": 0.0
  },
  "logging": {
    "wandb_project": "micro-MoRE-poc",
    "log_interval": 10
  }
}
