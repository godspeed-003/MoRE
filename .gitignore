# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# --- Weights & Biases -------------------------------------------------------
# Live W&B run payloads are large and machine-written. Provenance lives in
# runs/<experiment_id>/resolved_config.json (which records wandb_run_id), so
# nothing scientific is lost by not tracking these.
wandb/
code/wandb/

# --- Per-run output directories ---------------------------------------------
# runs/<experiment_id>/ IS the canonical record, so its small provenance and
# metric files are tracked. The large or regenerable payloads are excluded.
# This artifact ships no model weights: every checkpoint is reproducible from
# the frozen config recorded in its own run directory.
runs/**/checkpoint.pt
runs/**/*.pt
runs/**/stdout.log
runs/_*.log
/*.log

# --- Invalidated history ----------------------------------------------------
# archive/ holds artifacts declared void (superseded sweeps, crashed runs,
# one-epoch smoke runs, old dataset snapshots). The directory remains on disk
# as the record of what was invalidated and why; only tracking is declined.
archive/

# --- Generated opdiff datasets ----------------------------------------------
# Regenerated in ~10 s by the committed generator; the .npy arrays are data,
# not source.
opdiff_v3/
opdiff_v3_smoke/
opdiff_v4/
opdiff_v4_smoke/
opdiff_v4_calib/
opdiff_v2/
opdiff_v2_smoke/

# --- Machine-local interpreters ---------------------------------------------
.venv_cuda/

# --- Model checkpoints outside runs/ ----------------------------------------
*.pt

# --- Global output filenames that must never be committed -------------------
/best_model.pt
/results.tsv
/final_run_metrics.json
/sweep_results.csv
/1block_results.csv
/2block_results.csv
code/best_model.pt
code/results.tsv
code/final_run_metrics.json

# --- Gate smoke runs --------------------------------------------------------
# Gate 5 launches two real one-epoch training runs, so every suite execution
# deposits a fresh __rN directory. These are regenerable gate artifacts, not
# evidence. runs/t_l03_mor_timing_seed44__fa9339bc is deliberately not covered:
# it is cited as evidence and is tracked.
runs/t67_provenance_check*/
runs/t67d_provenance_check*/

# --- Language corpora -------------------------------------------------------
# data/lang/<corpus>/ is built, not authored: data/lang/build_language_dataset.py
# reproduces it from a pinned dataset revision recorded in the manifest. The
# definition files (dataset_meta.json, tokenizer.json, token_family.npy) are
# tracked; the regenerable payload is not.
data/lang/**/*.npy
!data/lang/**/token_family.npy
data/lang/**/*_text.txt
data/lang/**/*.bin
data/lang/_hf_cache/

# --- Secrets -----------------------------------------------------------------
# These are ignored, not deleted: the local machine still needs them. Any token
# that has been in a working tree should be rotated, not merely hidden.
.env
.env.*
!.env.example

# Third-party review correspondence
agent-review

# --- Stale build artefacts at the repository root ---------------------------
/acl_submission.pdf
/tmlr_submission.pdf

# --- Editor / OS ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp

# --- Paper build artefacts --------------------------------------------------
# Regenerable via paper/assemble_submissions.py and code/compile_papers.py.
paper/overleaf_*.zip
paper/*/main.pdf
paper/*/main.aux
paper/*/main.log
paper/*/main.out
paper/*/main.bbl
paper/*/main.blg
paper/*/main.lof
paper/*/main.lot
paper/*/main.toc

# scratch dir for pdftotext page measurement (code/main_content_pages.py)
build_tmp/

# TeX font-substitution log written by kpathsea on a minimal install
missfont.log
